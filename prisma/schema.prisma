datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Exercise {
    id BigInt @id @default(autoincrement())

    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
}

